# Env for `supabase functions serve --env-file` on the LOCAL stack. The functions
# run in a container; host.docker.internal reaches the capture server and the
# dpay mock on the host.
EMAIL_CAPTURE_URL=http://host.docker.internal:54399/send
PIPELINE_ALERT_EMAIL=operator@leszy.test
# Mocked dpay (tests/registration/helpers/dpayMock.js). Never real dpay values here.
DPAY_SERVICE=mock-service
DPAY_SECRET=mock-secret
DPAY_API_BASE=http://host.docker.internal:54398
DPAY_PANEL_BASE=http://host.docker.internal:54398
# The mock's /pbl/details is never cached: verifyRefund needs no wait after a 400 here (dpay: 10 s).
DPAY_REFUND_VERIFY_DELAY_MS=0
# Handed to dpay, never called by the functions: the mock runs on the host and posts
# the IPN there, and host.docker.internal does not resolve on a Linux CI runner.
DPAY_IPN_URL=http://127.0.0.1:54321/functions/v1/dpay-ipn
PUBLIC_SITE_URL=http://localhost:5173
# registration-jobs (pg_cron → pg_net): the x-jobs-secret header; the Vault seed holds the same value.
REGISTRATION_JOBS_SECRET=local-registration-jobs-secret
# registration-watchdog (pg_cron → pg_net, and the GitHub backstop): the x-watchdog-secret header; the Vault seed holds the same value.
REGISTRATION_WATCHDOG_SECRET=local-registration-watchdog-secret
# The /edge proxy's shared secret (public/vercel.json sets x-leszy-edge from the Vercel env of the same
# name; _shared/clientIp.js trusts the forwarded browser address only when it matches). Tests that send
# a client address send this header too, as the proxy would (EDGE_PROXY in helpers/stack.js).
EDGE_PROXY_SECRET=local-edge-proxy-secret
# The local switch for Plan 7's money features (donations, extras, vouchers), consulted only while
# PAID_REGISTRATION_ENABLED is false and only on an http:// local SUPABASE_URL (flags.js moneyFeaturesLive).
# With the flag true it changes nothing; money-live.test.js proves the off header is ignored.
REGISTRATION_MONEY_TEST=on
