# Copied to /etc/default/leszyrun-vision. Both camera services read it.
# Point the queue at the USB SSD for a race. ~/frames on the SD card is for a
# short test only: the database lives on that card.
VISION_QUEUE=/home/leszyrun/frames
# How long one capture run lasts. It stops cleanly after this and is not
# restarted; a crash is. 43200 is twelve hours, a race day.
VISION_SECONDS=43200
# Frames a second. The reader manages about 8 on a Pi 5; keep this below it
# or the view falls behind for the whole race.
VISION_FPS=6
# The reader skips frames further behind the newest than this, so the audit
# view stays live. Skipped frames stay on disk. 0 reads every frame.
VISION_MAX_LAG_S=3
# Minutes the reader keeps a frame it read and found nobody in, so a runner
# the person detector missed can still be looked at. Older empty frames are
# deleted. Frames with a person, or never read, are kept for the retention
# purge. The reader reads this from the environment.
VISION_KEEP_EMPTY_MIN=10
# Reader throttle, to leave CPU for the timing backend. Keep it above VISION_FPS.
VISION_READER_MAX_FPS=10
# Starting gain. Capture adapts gain and shutter to the light by itself.
VISION_GAIN=4.0
# Capture stops cleanly when the disk has less than this free.
VISION_MIN_FREE_GB=5
