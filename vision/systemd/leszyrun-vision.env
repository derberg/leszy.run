# Copied to /etc/default/leszyrun-vision. Both camera services read it.
# Point the queue at the USB SSD for a race. ~/frames on the SD card is for a
# short test only: the database lives on that card.
VISION_QUEUE=/home/leszyrun/frames
# How long one capture run lasts. It stops cleanly after this and is not
# restarted; a crash is. 43200 is twelve hours, a race day.
VISION_SECONDS=43200
# There is no automatic gain. Raise it when frames are dark.
VISION_GAIN=4.0
# Capture stops cleanly when the disk has less than this free.
VISION_MIN_FREE_GB=5
