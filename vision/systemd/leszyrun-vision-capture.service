[Unit]
Description=LeszyRun finish camera capture
After=time-sync.target
Wants=time-sync.target
# Keep retrying for as long as it takes: before NTP syncs, capture refuses to
# start and exits non-zero, and that should end in a capture, not a give-up.
StartLimitIntervalSec=0

[Service]
User=leszyrun
WorkingDirectory=/home/leszyrun/leszyrun/vision
EnvironmentFile=/etc/default/leszyrun-vision
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/leszyrun/leszyrun/vision/.venv/bin/python scripts/capture.py \
  --queue ${VISION_QUEUE} --seconds ${VISION_SECONDS} \
  --gain ${VISION_GAIN} --min-free-gb ${VISION_MIN_FREE_GB} --fps ${VISION_FPS}
# on-failure, not always: a run that ended because its time was up or the
# disk reached its margin exited cleanly and must stay stopped.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
